{
  "name": "image",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "deploy": "pnpm build && node scripts/wrangler.mjs deploy",
    "start": "pnpm build && wrangler dev --test-scheduled",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "debug:moderation": "node --experimental-strip-types scripts/debug-moderation.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/wrangler.mjs d1 migrations apply DB --remote",
    "wrangler:remote": "node scripts/wrangler.mjs",
    "db:import:kv": "node scripts/import-kv.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "24.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
